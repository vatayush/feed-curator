{
  "manifest_version": 3,
  "name": "Feed Curator Capture",
  "version": "0.1.1",
  "description": "Reads your X and LinkedIn feeds when asked to, and saves the posts for Claude to curate. Read-only.",
  "key": "",
  "permissions": [
    "alarms",
    "downloads",
    "downloads.ui",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/home*",
        "https://www.linkedin.com/feed/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Feed Curator"
  }
}
